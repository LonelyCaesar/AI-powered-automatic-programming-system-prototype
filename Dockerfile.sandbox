FROM python:3.11-slim-bookworm

# Company sandbox runtime: Python / Node / Java / SQLite / PostgreSQL client.
# Tk applications can use Xvfb/noVNC or an optional Windows X Server from the human Sandbox terminal.
USER root

RUN mkdir -p /var/lib/apt/lists/partial /var/cache/apt/archives/partial \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        nodejs \
        npm \
        openjdk-17-jdk-headless \
        sqlite3 \
        postgresql-client \
        tk \
        python3-tk \
        fonts-noto-cjk \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        fluxbox \
        libgl1 \
        libglib2.0-0 \
        libxkbcommon-x11-0 \
        libxcb-cursor0 \
        xauth \
        x11-utils \
        ca-certificates \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Preinstall common offline test and generated-app modules. Runtime containers
# use --network none, so Streamlit projects must already have their runtime.
RUN pip install --no-cache-dir \
        pytest \
        numpy \
        pandas \
        matplotlib \
        plotly \
        streamlit \
        yfinance \
        pandas-ta-classic \
        PyQt5 \
        flask \
        fastapi \
        "uvicorn[standard]" \
        httpx \
        requests

# Small diagnostic used from the Sandbox terminal before launching Tk/PyQt apps.
RUN printf '%s\n' \
      '#!/bin/sh' \
      'if [ -z "$DISPLAY" ]; then echo "X11 disabled: DISPLAY is empty"; exit 2; fi' \
      'echo "DISPLAY=$DISPLAY"' \
      'if xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then echo "X11 OK"; exit 0; fi' \
      'echo "X11 unavailable: start/configure the Windows X Server, then retry."' \
      'exit 1' \
      > /usr/local/bin/cubi-x11-check \
    && chmod +x /usr/local/bin/cubi-x11-check

RUN if id -u sandbox >/dev/null 2>&1; then \
        usermod --shell /bin/bash sandbox; \
    else \
        useradd --create-home --shell /bin/bash sandbox; \
    fi \
    && mkdir -p /workspace \
    && chown -R sandbox:"$(id -gn sandbox)" /workspace

WORKDIR /workspace
USER sandbox

CMD ["/bin/bash", "--noprofile", "--norc", "-i"]
