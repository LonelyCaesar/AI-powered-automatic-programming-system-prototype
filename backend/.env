# Cubi Code Node.js / Express backend
PORT=8000
HOST=127.0.0.1
APP_NAME=Cubi Code

# Login
CUBI_LOGIN_USERNAME=admin
CUBI_LOGIN_PASSWORD=cubi1234

# First installation: remove packaged/demo diff and audit history once only.
CUBI_CLEAR_HISTORY_ON_FIRST_START=true

# Default project workspace. Relative paths resolve from the Cubi Code project root.
# Example: D:\Cubi_Code_AI_整理版\my_project\my_project
# New projects are created as D:\Cubi_Code_AI_整理版\my_project\<project_name>
# On backend startup: create it if missing; otherwise open/reuse it.
CUBI_WORKSPACE_DIR=my_project

# Human terminal: Docker Sandbox shell with the project mounted at /workspace.
# Web terminal is forced into an isolated Docker Sandbox. Host shell mode is disabled.
CUBI_TERMINAL_MODE=sandbox
CUBI_TERMINAL_PROFILE=docker
CUBI_TERMINAL_CWD=my_project
CUBI_TERMINAL_SHELL=
CUBI_TERMINAL_PYTHON=

# Windows X Server support for GUI programs launched INSIDE the Docker Sandbox terminal.
# Python/Tkinter still executes in Docker; Windows only displays the X11 window.
CUBI_TERMINAL_X11_ENABLED=true
CUBI_TERMINAL_X11_DISPLAY=host.docker.internal:0.0
CUBI_TERMINAL_NETWORK=bridge
CUBI_TERMINAL_APP_PORT_MIN=1024
CUBI_TERMINAL_APP_PORT_MAX=9999

# PostgreSQL primary database
DB_PROVIDER=postgresql
ENTERPRISE_DB_PROVIDER=postgresql
DATABASE_URL=postgresql://admin:password@127.0.0.1:5433/cubi_postgres
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=cubi_postgres
DB_USER=admin
DB_PASSWORD=password

# DB read-only guard
ALLOWED_TABLES_PATH=backend/data/allowed_tables.json
ENTERPRISE_ALLOWED_TABLES_PATH=backend/data/enterprise_allowed_tables.json
MAX_DB_ROWS=50
ENTERPRISE_DB_MAX_ROWS=100

# Ollama / model routing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=auto
MODEL_SOURCE=local_ollama
MODEL_ROUTING_MODE="local_first"
OLLAMA_CONNECT_TIMEOUT=5000
OLLAMA_READ_TIMEOUT=900000
OLLAMA_NUM_PREDICT=900
OLLAMA_NUM_CTX=16384
OLLAMA_MAX_RETRIES=1

# Optional OpenAI-compatible cloud API
CLOUD_API_ENABLED=false
CLOUD_API_PROVIDER=OpenAI / Azure OpenAI API
CLOUD_API_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4.1-mini
REQUIRE_CLOUD_APPROVAL=true

# Docker sandbox status
DOCKER_SANDBOX_MODE=auto
DOCKER_SANDBOX_IMAGE=cubi-code-pytest-sandbox:latest
DOCKER_SANDBOX_TIMEOUT=0
AI_FEATURE_SANDBOX_TIMEOUT=120
DOCKER_SANDBOX_MEMORY=512m
DOCKER_SANDBOX_CPUS=1.0
DOCKER_SANDBOX_NETWORK_DISABLED=true

# Codex connector status bridge (actual OAuth is managed in Codex / ChatGPT workspace)
CODEX_GITHUB_CONNECTED=false
CODEX_GITHUB_REPO=
CODEX_GITHUB_WORKSPACE=

